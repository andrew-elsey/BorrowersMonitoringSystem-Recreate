# Copy to .env and fill in the values marked "Required". Never commit .env.
# Variables are described in docs/ARCHITECTURE.md section 10.

# --- Database ---
POSTGRES_USER=bms
# Required. Use letters and digits only: it is placed inside DATABASE_URL without escaping.
POSTGRES_PASSWORD=
POSTGRES_DB=bms
# Prisma connection string. docker compose builds it from the three values above, so set it
# only when running the API outside Docker.
# DATABASE_URL=postgresql://bms:<password>@localhost:5432/bms

# --- Sessions (used from AUTH-1) ---
# Required from AUTH-1. A long random string, for example the output of: openssl rand -hex 32
SESSION_SECRET=
SESSION_TTL_HOURS=8
# Must be false when the app is served over plain HTTP on the LAN, or browsers drop the cookie.
COOKIE_SECURE=false

# --- Time ---
APP_TIMEZONE=Asia/Manila
TZ=Asia/Manila

# --- First admin, created by the seed script (FND-4) ---
ADMIN_USERNAME=admin
# Required: docker compose will not start without it. At least 10 characters.
# The seed runs on every api start and creates this admin only if the username does not exist yet,
# so changing this value later never changes an existing password. Change it after the first login.
ADMIN_PASSWORD=

# --- Network ---
# Published web port.
WEB_PORT=8080
# Address the web port is bound to. 127.0.0.1 means this machine only. On the department PC,
# set the PC's LAN address (for example 192.168.1.20). Never expose the app to the internet.
WEB_BIND_ADDRESS=127.0.0.1
# Number of proxies in front of the API (nginx = 1).
TRUST_PROXY_HOPS=1

# --- Password hashing limiter (ARCHITECTURE.md 12.4) ---
HASH_CONCURRENCY=2
HASH_QUEUE_MAX=10

# NODE_ENV is set to production inside the containers by docker-compose.yml.
